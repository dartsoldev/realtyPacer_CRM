# RealtyPacer environment configuration.
# Copy to .env.local for development. Never commit real values.

# --- MongoDB -----------------------------------------------------------------
# Atlas or self-hosted connection string. If the username or password contains
# special characters (@ : / ? # [ ] % etc.) they MUST be URI-encoded,
# e.g. "p@ss:word" -> "p%40ss%3Aword".
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_HOST>/realtypacer

# --- Application URL ---------------------------------------------------------
# Trusted public origin. Used for every link in transactional email and for
# Origin (CSRF) checks. Never derived from the incoming request Host header.
APP_URL=http://localhost:3000

# --- Auth.js / NextAuth v4 ---------------------------------------------------
# NEXTAUTH_URL must equal APP_URL.
NEXTAUTH_URL=http://localhost:3000
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET=

# --- SMTP (transactional email) ----------------------------------------------
# Use a provider where the EMAIL_FROM domain/sender is verified (SPF/DKIM).
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (usually port 465); "false" uses STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# e.g. "RealtyPacer <no-reply@realtypacer.com>"
EMAIL_FROM=

# --- First superadmin --------------------------------------------------------
# Used only by `npm run bootstrap:superadmin`. Does not grant anything by itself.
SUPERADMIN_EMAIL=

# --- Rate limiting -----------------------------------------------------------
# Counters are stored in MongoDB (collection `ratelimits`), shared by every
# server instance. No extra service is required.
# Set to "true" only when the app runs behind a proxy that overwrites
# X-Forwarded-For (Vercel, a configured load balancer). Otherwise client IPs
# cannot be trusted and only per-account limits are applied.
TRUST_PROXY_HEADERS=false
