# RealtyPacer environment configuration — PLACEHOLDERS ONLY.
# Development: copy to .env.local. Production: provide these as secrets in
# your hosting platform (or .env.production, which is gitignored).
# Never commit real values.

# =============================================================================
# REQUIRED
# =============================================================================

# --- MongoDB (must be a REPLICA SET: Atlas, or self-hosted with --replSet) ----
# Bookings, payments, credit and points use multi-document transactions, which
# a standalone mongod does not support. URI-encode special characters in the
# username/password (e.g. "p@ss:word" -> "p%40ss%3Aword").
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_HOST>/realtypacer

# --- Application URL ---------------------------------------------------------
# Trusted public origin (https://realtypacer.com in production). Used for every
# link in emails, Origin (CSRF) checks and Twilio webhook signatures. Never
# derived from the incoming Host header.
APP_URL=http://localhost:3000

# --- Auth (NextAuth v4) --------------------------------------------------------
# NEXTAUTH_URL must equal APP_URL.
NEXTAUTH_URL=http://localhost:3000
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET=

# --- SMTP (transactional email) ------------------------------------------------
# Required for invitations, verification and password reset. Use a provider
# where the EMAIL_FROM domain is verified (SPF, DKIM, DMARC).
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (usually 465); "false" uses STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# e.g. "RealtyPacer <no-reply@realtypacer.com>"
EMAIL_FROM=

# =============================================================================
# OPTIONAL
# =============================================================================

# --- First superadmin (used only by the bootstrap command) --------------------
SUPERADMIN_EMAIL=

# --- Proxy headers -----------------------------------------------------------
# "true" only behind a proxy that overwrites X-Forwarded-For (your load
# balancer / reverse proxy). Otherwise only per-account rate limits apply.
TRUST_PROXY_HEADERS=false

# --- Background worker ---------------------------------------------------------
# Seconds between outbox polls (2–300). The worker is required when booking
# emails are enabled or queued security emails must be retried.
WORKER_POLL_SECONDS=15

# --- Private file storage (S3-compatible) ---------------------------------------
# Leave S3_BUCKET empty to disable photos/documents (the app says so honestly).
# The bucket must block all public access; allow CORS PUT from APP_URL only.
S3_BUCKET=
S3_REGION=us-east-1
# Only for non-AWS providers (Cloudflare R2, Backblaze B2, Wasabi, MinIO…):
S3_ENDPOINT=
# Origin browsers upload to, if different from S3_ENDPOINT (used for CSP).
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "true" for path-style providers (MinIO, some S3 clones).
S3_FORCE_PATH_STYLE=false

# --- Calling ---------------------------------------------------------------------
# "tel" (default): numbers open the device's phone app.
# "browser": additionally enables outbound browser calling through Twilio Voice
# (all TWILIO_* values below become required).
CALLING_MODE=tel
TWILIO_ACCOUNT_SID=
# API key (SK…) and secret used to sign short-lived voice access tokens.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Used only to validate webhook signatures.
TWILIO_AUTH_TOKEN=
# TwiML App (AP…) whose Voice URL is APP_URL/api/v1/telephony/twilio/voice
TWILIO_TWIML_APP_SID=
# A number you own in Twilio, in E.164 format (e.g. +14165550100).
TWILIO_CALLER_ID=
# ISO country codes calls may be placed to.
CALLING_ALLOWED_COUNTRIES=CA,US

# --- Google Calendar (optional; outbound booking events) ----------------------
# All three are needed; without GOOGLE_CLIENT_ID the integration shows
# "Not connected" with setup steps. See docs/GOOGLE_CALENDAR.md.
# Authorized redirect URI to register in Google Cloud:
#   APP_URL/api/v1/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored Google refresh tokens (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes stored tokens unreadable (reconnect Google afterwards).
TOKEN_ENCRYPTION_KEY=

# --- Tests only --------------------------------------------------------------------
# Any MongoDB replica set; each run uses and drops a random realtypacer_test_* DB.
TEST_MONGODB_URI=
